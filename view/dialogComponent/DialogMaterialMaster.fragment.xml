<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="idMaterialMasterDialog" title="Select Material Master" draggable="true" resizable="true">
		<content>
			<Toolbar>
				<SearchField id="idMaterialSearchField" placeholder="Search..." liveChange=".onSearchMaterialMaster"/>
				<!--<ToolbarSpacer/>
                <Button text="Select All" press=".onSelectAllMaterialMaster"/>-->
			</Toolbar>
			<List 
			id="idMaterialMasterList" 
			mode="MultiSelect"
			growing="true" 
			growingThreshold="1000" 
			selectionChange=".onSelectionChangeMaterialMaster"
			items="{materialMasterData>/}">
			    
				<StandardListItem title="{materialMasterData>matkl}" description="{materialMasterData>wgbez}"/>
			</List>
		</content>
		<buttons>
			<Button text="OK" press=".onConfirmMaterialMaster"/>
			<Button text="Cancel" press=".onCloseMaterialMaster"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>